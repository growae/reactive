{
  "name": "@growae/reactive",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/esm/exports/index.js",
  "types": "dist/types/exports/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/exports/index.d.ts",
      "default": "./dist/esm/exports/index.js"
    },
    "./actions": {
      "types": "./dist/types/exports/actions.d.ts",
      "default": "./dist/esm/exports/actions.js"
    },
    "./query": {
      "types": "./dist/types/exports/query.d.ts",
      "default": "./dist/esm/exports/query.js"
    },
    "./networks": {
      "types": "./dist/types/exports/networks.d.ts",
      "default": "./dist/esm/exports/networks.js"
    },
    "./connectors": {
      "types": "./dist/types/exports/connectors.d.ts",
      "default": "./dist/esm/exports/connectors.js"
    },
    "./internal": {
      "types": "./dist/types/exports/internal.d.ts",
      "default": "./dist/esm/exports/internal.js"
    },
    "./package.json": "./package.json",
    "./protocol": {
      "types": "./dist/types/exports/protocol.d.ts",
      "default": "./dist/esm/exports/protocol.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:esm+types",
    "build:esm+types": "tsc --project tsconfig.bootstrap.json --outDir ./dist/esm --declaration --declarationMap --declarationDir ./dist/types",
    "build:connectors": "pnpm --filter @growae/reactive-connectors run build && tsc --project tsconfig.build.json --outDir ./dist/esm --declaration --declarationMap --declarationDir ./dist/types",
    "clean": "rm -rf dist",
    "check:types": "tsc --noEmit",
    "test:node-resolution": "node scripts/test-node-resolution.mjs",
    "dev": "tsc --project tsconfig.build.json --outDir ./dist/esm --declaration --declarationMap --declarationDir ./dist/types --watch",
    "prebuild": "pnpm run clean"
  },
  "dependencies": {
    "eventemitter3": "^5.0.0",
    "zustand": "^5.1.0",
    "json-bigint": "^1.0.0"
  },
  "peerDependencies": {
    "@growae/reactive-connectors": "workspace:*",
    "@tanstack/query-core": ">=5.0.0 <6.0.0",
    "typescript": ">=5.7.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "@growae/reactive-connectors": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.107.1",
    "@types/json-bigint": "^1.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#ae-protocol": "./protocol-generated/core-harness.js"
  },
  "files": [
    "dist",
    "protocol-generated"
  ]
}
